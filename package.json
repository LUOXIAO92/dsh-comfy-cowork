{
  "name": "dsh-comfy-cowork",
  "version": "0.1.0",
  "description": "Human + agent image/video coworking canvas for ComfyUI, inside DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "image-editing",
    "canvas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LUOXIAO92/dsh-comfy-cowork.git"
  },
  "homepage": "https://github.com/LUOXIAO92/dsh-comfy-cowork#readme",
  "bugs": {
    "url": "https://github.com/LUOXIAO92/dsh-comfy-cowork/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js",
    "prepare": "npm run build",
    "prepack": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
